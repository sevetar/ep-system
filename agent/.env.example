APP_ENV=local
API_AUTH_TOKEN=
LOG_LEVEL=INFO

# Local infrastructure is owned by ../backend/compose.yaml.
# When the Agent runs on the host, connect through the published host port.
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=flowfix-knowledge-v1
KNOWLEDGE_ROOT=../backend/docs
RUNTIME_DIR=.runtime

# Prefer OPENAI_API_KEY in normal environments. Local development may point to
# a NewAPI connection JSON file instead; neither value belongs in Git.
OPENAI_BASE_URL=https://api.example.com/v1
OPENAI_API_KEY=replace-me
MODEL_CONNECTION_FILE=

JAVA_DISPATCH_BASE_URL=http://localhost:8085/internal/dispatch/v1
JAVA_DISPATCH_TIMEOUT_SECONDS=3
DISPATCH_TOOL_TIMEOUT_SECONDS=5
DISPATCH_EXECUTION_TIMEOUT_SECONDS=60
DISPATCH_APPROVAL_TTL_SECONDS=3600

# Memory storage. STORE_BACKEND=mysql uses the MySQL instance owned by the
# Java service; store_adapter=sqlite keeps the local file fallback.
STORE_BACKEND=sqlite
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3308
MYSQL_USER=root
MYSQL_PASSWORD=change-me-local
MYSQL_DATABASE=flowfix_agent

# LangGraph checkpointing. REDIS_CHECKPOINT_ENABLED=true (默认) replaces the
# in-memory saver with AsyncRedisSaver backed by REDIS_URL. The Redis must
# provide the RediSearch module, so it reuses the Java-side ep-manage-redis
# (already upgraded to redis-stack-server) at 6379 — no duplicate instance.
# 本地无 Redis 时改为 false，退化为 InMemorySaver。
REDIS_URL=redis://127.0.0.1:6379
REDIS_CHECKPOINT_ENABLED=true

# 链三调查与规划：最大重规划次数与单 Agent 只读调查最大步数；完成门禁必填角色。
MAX_REPLANS=1
INVESTIGATION_MAX_STEPS=6
COMPLETION_REQUIRED_ROLES=[]

CHAT_MODEL=qwen3.5-flash
# 规则无法确定意图时才调用结构化模型分类；失败会安全退化为澄清。
ROUTER_LLM_FALLBACK_ENABLED=true
# Diagnosis Worker 单次执行的最大知识检索次数（只读，最多 10）。
DIAGNOSIS_MAX_QUERIES=3
# ImpactSafety Worker 单次执行的最大知识检索次数（只读，最多 10）。
IMPACT_SAFETY_MAX_QUERIES=3
# ResourcePlanning Worker 单次执行的最大知识检索次数（只读，最多 10）。
RESOURCE_PLANNING_MAX_QUERIES=3
EMBEDDING_MODEL=qwen3-embedding-0.6b
EMBEDDING_DIMENSIONS=1024
RERANK_MODEL=qwen3-reranker-0.6b
RERANK_ENABLED=true

BM25_TOP_K=20
VECTOR_TOP_K=20
FINAL_TOP_K=6
RRF_K=60
EVIDENCE_TOKEN_BUDGET=3000
VECTOR_MIN_SCORE=0.60
RERANK_MIN_SCORE=0.20

# MCP Streamable HTTP server is mounted at /mcp. Production must set a
# dedicated MCP_AUTH_TOKEN. Remote providers are opt-in and statically map
# local capabilities to remote tool names, e.g. {"knowledge.search":"search"}.
MCP_SERVER_ENABLED=false
MCP_AUTH_TOKEN=
MCP_ALLOWED_TENANTS=["public"]
MCP_REMOTE_URL=
MCP_REMOTE_TOKEN=
MCP_REMOTE_CAPABILITIES={}
MCP_TIMEOUT_SECONDS=10

# Reliable asynchronous dispatch. Reuses the Java-side RabbitMQ and Redis;
# no extra broker is created. HA mode additionally enforces MySQL + Redis + RabbitMQ.
RABBITMQ_ENABLED=false
# 完工工单自动拆分为维修案例并写入 Elasticsearch；启用后需同时可用 RabbitMQ、Redis。
WORK_ORDER_KNOWLEDGE_ENABLED=false
RABBITMQ_URL=amqp://admin:change-me-local@127.0.0.1:5672/
RABBITMQ_RETRY_DELAY_MS=5000
RABBITMQ_MAX_RETRIES=3
HA_MODE_ENABLED=false
# Optional override; otherwise defaults to <hostname>-<pid> and is unique per process.
# INSTANCE_ID=flowfix-agent-1
